# Telegram bot token from @BotFather
BOT_TOKEN=replace_me

# Public HTTPS URL where the Mini App is served (no trailing slash)
# For local testing use ngrok: ngrok http 8080  ->  https://xxxx.ngrok-free.app
WEBAPP_URL=https://your-public-url.example.com

# Server bind
HOST=0.0.0.0
PORT=8080

# Set to 1 to allow opening the WebApp in a regular browser without Telegram (dev only)
DEV_MODE=0
