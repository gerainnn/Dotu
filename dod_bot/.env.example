# Telegram bot token from @BotFather (REVOKE the old one if it leaked)
TG_BOT_TOKEN=replace_me

# LLM provider — any OpenAI-compatible endpoint works
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=anthropic/claude-3.5-sonnet
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# Together:      LLM_BASE_URL=https://api.together.xyz/v1          LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Local llama.cpp / vllm / ollama (with /v1): LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Sampling
LLM_TEMPERATURE=0.85
# Optional cap; leave empty for provider default
LLM_MAX_TOKENS=

# How many last messages to feed back into context (user+assistant turns combined)
HISTORY_LIMIT=40

# Whitelist of TG user ids (comma separated). Empty = anyone who finds the bot can talk.
# Use /whoami in your own bot to find your id.
ALLOWED_USERS=
